{
  "expo": {
    "name": "Spot It",
    "slug": "spotit",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotit.app"
    },
    "android": {
      "package": "com.spotit.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.spotit.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF3EF",
        "foregroundImage": "./assets/icon-adaptive.png"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCEEEA",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#160A0C",
            "image": "./assets/splash.png"
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C04E68",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "71955428-691c-4a81-a6c9-9c79dd418afa"
      }
    },
    "owner": "spotitinternational",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/71955428-691c-4a81-a6c9-9c79dd418afa",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
